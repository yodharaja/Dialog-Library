<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Terms &amp; Conditions"
        android:textColor="@color/colorTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Last updated: September 2026"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_badge_rounded"
        android:backgroundTint="@color/colorSurfaceVariant"
        android:padding="12dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tv_terms_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Acceptance of Terms\nBy accessing and using this application, you accept and agree to be bound by the terms and provisions of this agreement.\n\n2. Modular Components\nAll dialog classes and layouts provided in this library are modular and can be integrated into custom Sketchware and Android Studio projects.\n\n3. Intellectual Property\nYou may freely use, modify, and distribute these dialog components in both personal and commercial applications.\n\n4. Privacy\nNo private personal data is collected or transmitted by this showcase application."
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.2" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_btn_decline"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Decline"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_btn_accept"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="I Agree"
            android:textStyle="bold"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/colorOnPrimary" />
    </LinearLayout>
</LinearLayout>
