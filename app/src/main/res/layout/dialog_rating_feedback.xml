<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rate Your Experience"
        android:textColor="@color/colorTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap a star to give your rating."
        android:textColor="@color/colorTextSecondary"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/rating_stars_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/star_1"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_star"
            android:layout_marginEnd="6dp"
            android:contentDescription="1 Star" />
        <ImageView
            android:id="@+id/star_2"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_star"
            android:layout_marginEnd="6dp"
            android:contentDescription="2 Stars" />
        <ImageView
            android:id="@+id/star_3"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_star"
            android:layout_marginEnd="6dp"
            android:contentDescription="3 Stars" />
        <ImageView
            android:id="@+id/star_4"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_star"
            android:layout_marginEnd="6dp"
            android:contentDescription="4 Stars" />
        <ImageView
            android:id="@+id/star_5"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_star_border"
            android:contentDescription="5 Stars" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/feedback_input_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Leave a comment (optional)"
        app:boxStrokeColor="@color/colorPrimary"
        android:layout_marginBottom="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/feedback_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top|start"
            android:textColor="@color/colorTextPrimary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_btn_submit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Submit Review"
        android:textStyle="bold"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@color/colorOnPrimary" />
</LinearLayout>
