<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <!-- Animated Bouncing Icon Container -->
    <FrameLayout
        android:id="@+id/anim_icon_container"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_circle_container"
        android:backgroundTint="@color/colorWarningContainer"
        android:layout_marginBottom="20dp">
        <ImageView
            android:id="@+id/anim_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_trophy"
            android:contentDescription="Trophy" />
    </FrameLayout>

    <TextView
        android:id="@+id/anim_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sensational Work!"
        android:textColor="@color/colorTextPrimary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/anim_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smooth spring &amp; scale animations crafted natively with Android ObjectAnimator."
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="20dp" />

    <!-- Badges Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/colorPrimaryContainer"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="🔥 +1,000 XP"
            android:textColor="@color/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/colorSuccessContainer"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="⭐ Top Rank"
            android:textColor="@color/colorSuccess"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/anim_btn_continue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Claim &amp; Continue"
        android:textStyle="bold"
        android:backgroundTint="#F59E0B"
        android:textColor="@color/colorOnPrimary" />
</LinearLayout>
