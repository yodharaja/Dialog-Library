<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/colorPrimaryContainer"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sparkle"
                android:contentDescription="What's New" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What's New in v2.0"
                android:textColor="@color/colorTextPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Latest features &amp; improvements"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Feature 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check_circle"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Bullet" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="28+ Famous Dialogs: Complete suite of SweetAlert, Material 3, and BottomSheets."
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.2" />
    </LinearLayout>

    <!-- Feature 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check_circle"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Bullet" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modular Architecture: Each dialog has its own Java &amp; XML file ready to copy to your project."
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.2" />
    </LinearLayout>

    <!-- Feature 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check_circle"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Bullet" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pure Light Theme: High contrast typography, soft surfaces, and modern squircles."
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.2" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_btn_ok"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Got It, Thanks!"
        android:textStyle="bold"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@color/colorOnPrimary" />
</LinearLayout>
