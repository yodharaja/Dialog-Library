<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_badge_rounded"
        android:backgroundTint="@color/colorWarningContainer"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_trophy"
            android:contentDescription="Reward" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Achievement Unlocked!"
        android:textColor="@color/colorTextPrimary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Master of Dialogs"
        android:textColor="#D97706"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You've unlocked 500 XP and the Golden Badge for exploring the advanced dialog suite!"
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_btn_claim"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Claim Reward"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#F59E0B"
        android:textColor="@color/colorOnPrimary" />
</LinearLayout>
